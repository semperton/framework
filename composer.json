{
    "name": "semperton/framework",
    "description": "The Semperton Framework.",
    "type": "library",
    "keywords": [
        "framework",
        "psr-7",
        "psr-15",
        "router",
        "middleware",
        "microframework"
    ],
    "homepage": "https://github.com/semperton/framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Johannes Rabausch",
            "email": "mail@jrabausch.de"
        }
    ],
    "support": {
        "issues": "https://github.com/semperton/framework/issues",
        "source": "https://github.com/semperton/framework"
    },
    "autoload": {
        "psr-4": {
            "Semperton\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semperton\\Framework\\Tests\\": "tests/",
            "Semperton\\Framework\\Benchmark\\": "benchmark/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "psalm --no-cache",
            "psalm --no-cache --taint-analysis",
            "php-cs-fixer check"
        ],
        "fix": "php-cs-fixer fix",
        "bench": "phpbench run --report=aggregate"
    },
    "require": {
        "php": "^8.2",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "semperton/routing": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "giorgiosironi/eris": "^1.2.1",
        "nyholm/psr7": "^1.8",
        "phpbench/phpbench": "^1.4",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "nyholm/psr7": "Fast PSR-7 / PSR-17 implementation",
        "psr/container-implementation": "Resolves handlers and middleware by id"
    }
}
